# Copy to .env and adjust for your environment.
DATABASE_URL=postgres://docflow:docflow_dev@localhost:5432/docflow

# Used by `npm test`. Tests refuse to run unless the database is named docflow_test;
# create it once with `node scripts/create-test-db.mjs`.
DATABASE_URL_TEST=postgres://docflow:docflow_dev@localhost:5432/docflow_test

# Public origin the app is served from. Every non-GET /api request must carry a matching
# Origin header (or Sec-Fetch-Site: same-origin) or it is refused (CSRF). REQUIRED in production.
APP_BASE_URL=http://localhost:8080

# Set to 1 only behind Caddy on the firm PC so rate limits see the real client IP.
# TRUST_PROXY=1

# Sessions: opaque server rows, 30 min idle / 12 h absolute (server/src/auth/sessions.ts).
# Throttles (per 15 min): RATE_LIMIT_LOGIN_IP=20  RATE_LIMIT_LOGIN_EMAIL=10  RATE_LIMIT_MFA_VERIFY=5  RATE_LIMIT_GLOBAL=600
# Invitation / reset link lookups (per hour, per IP): RATE_LIMIT_LOOKUP_IP=10

# Passwords: bcrypt cost 12, minimum 12 characters (server/src/auth/passwords.ts). Outside
# production PASSWORD_BCRYPT_COST can lower the cost (the test suite uses 4).
# Admin CLI (`npm run admin -- create-advisor --email … --name … --firm …`) prompts for the
# password on the console; set DOCFLOW_ADMIN_PASSWORD to pass it non-interactively (scripts only).

# Encrypts authenticator (TOTP) secrets at rest. REQUIRED in production; elsewhere a fixed
# development key is used and a warning is printed. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key locks every user out of MFA (the admin CLI in C1.3 can reset them).
# APP_ENCRYPTION_KEY=

# Name shown in authenticator apps next to the account (default "DocFlow").
# MFA_ISSUER=DocFlow

# --- Document storage (server/src/files/) ---------------------------------------
# Where document bytes live: `<DATA_ROOT>/files/yyyy/mm/<uuid>.<ext>`, immutable
# (a replacement is a new version, never an overwrite). REQUIRED in production and
# must sit on the encrypted data volume, never inside the repo, OneDrive or Desktop.
# Outside production it defaults to server/.data (gitignored).
# The legacy server/uploads/ tree is left untouched until C5.4; nothing new goes there.
# DATA_ROOT=D:\docflow-data

# Uploads land here first, before anything has decided they are safe. Defaults to
# <DATA_ROOT>/staging. Keep it on the same volume as DATA_ROOT so publishing is a
# rename rather than a copy. The hourly sweeper deletes anything left over an hour.
# STAGING_DIR=

# --- Virus scanning (server/src/files/scan.ts) ----------------------------------
# clamd, spoken to over its INSTREAM socket. REQUIRED in production: nothing is ever
# marked clean unless a scanner said so, and an unreachable scanner means uploads are
# stored but stay unreadable (never rejected, never published) until it is back.
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310
# CLAMD_TIMEOUT_MS=60000
#
# Set to false ONLY in dev/test on a machine with no clamd. It does not mean
# "publish anyway": uploads are accepted and left pending, which is the honest
# state for a file nothing has looked at. Ignored in production.
# SCAN_REQUIRED=false

# Uploads per hour, per session (default 60).
# RATE_LIMIT_UPLOADS=60

# How much one CLIENT may store, in bytes (default 2 GiB). The volume that
# holds the documents also holds the database and the backups, in that order of
# consequence, and the 25 MB per-file limit does not help when the same person
# sends two hundred files. Checked from Content-Length before anything is
# staged and from the real size afterwards; quarantined versions do not count
# (their bytes were deleted). Advisors are exempt — they are the ones who would
# have to clear the space.
# MAX_CLIENT_STORAGE_BYTES=2147483648

# --- Background jobs and email (server/src/jobs/) -------------------------------
# The worker is its own process: `npm run worker` in development, the docflow-worker
# service on the firm PC (C5.3). The queue is the `jobs` table, so nothing is lost
# across restarts. GET /api/ops/status reports queue depth and mail configuration.
# WORKER_POLL_MS=5000        # how often an idle worker asks for work
# WORKER_BATCH=5             # jobs claimed per pass

# Mail is OPTIONAL and degrades cleanly: with SMTP_URL unset no email job is queued,
# `emailQueued` is false, and invitations / password resets are copy-link only. The
# self-service "forgot password" form is the one path with no copy-link, so it does
# nothing visible until this is set.
#   Microsoft 365:  smtps://user%40firm.com:APP_PASSWORD@smtp.office365.com:587
#   Gmail:          smtps://user%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
# Percent-encode the @ in the username and any special characters in the password.
# SMTP_URL=
# MAIL_FROM=DocFlow <docflow@yourfirm.com>

PORT=4000
CORS_ORIGIN=http://localhost:8080
NODE_ENV=development

# The interface the API binds to. Defaults to 127.0.0.1 — the browser and the
# server are the same machine here, and an unspecified host would put the API
# (and every session cookie crossing it) on whatever wifi the laptop joins.
# Set this only to deliberately expose it, e.g. HOST=0.0.0.0 behind a firewall.
# HOST=127.0.0.1

# Serve the built SPA from this process (npm run build at the repo root first).
# One origin on 127.0.0.1:4000 answers both the app and /api, with an HTML
# Content-Security-Policy that Vite's dev server does not send. Leave it unset
# for development, where Vite serves :8080 and proxies /api.
#   npm run build          (repo root)
#   SERVE_STATIC=1 NODE_ENV=production npm start
# With this on, CORS is not mounted at all — there is only one origin, so the
# CORS_ORIGIN line above is ignored rather than quietly granting :8080
# credentialed access to the API.
# SERVE_STATIC=1

# How long file-type detection may run before the worker thread parsing the
# bytes is killed and the upload is refused (default 2000 ms). Untrusted bytes
# are never parsed on the event loop; see server/src/files/sniff.ts.
# SNIFF_TIMEOUT_MS=2000

# Self-service advisor signup (POST /api/auth/signup-provider). Off unless exactly "true";
# the pilot provisions advisors locally instead.
ALLOW_PROVIDER_SIGNUP=false

# ---- Reminders (C4.3) ----
# The firm's own day: reminders go out at 08:00 here, and "overdue" is measured
# against this calendar rather than UTC. An IANA name, e.g. America/Chicago.
FIRM_TIMEZONE=America/Chicago

# =============================================================================
# PRODUCTION (the firm PC) — C5.3
# =============================================================================
# What changes when this file is the one on the firm PC rather than a laptop.
# ops\windows\install.ps1 copies this example into place; these are the lines
# that must be edited before the services are started.
#
# NODE_ENV=production is set by the Windows services, not here.

# The database, as docflow_app on loopback. Percent-encode anything exotic in
# the password. The role is the database owner; docflow_backup (read-only) is
# what the nightly pg_dump uses.
# DATABASE_URL=postgres://docflow_app:PASSWORD@127.0.0.1:5432/docflow

# 32+ random bytes each, generated on the machine and never reused between
# installations:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SESSION_SECRET rotates every session; APP_ENCRYPTION_KEY decrypts the stored
# TOTP secrets — LOSING IT MEANS EVERY USER RE-ENROLLS THEIR AUTHENTICATOR.
# Both belong in the firm's password manager as well as in this file.
# SESSION_SECRET=
# APP_ENCRYPTION_KEY=

# Documents and staging, on the BitLocker-encrypted data volume. Never inside
# the repository, and never on C: — see the runbook.
# DATA_ROOT=D:\docflow-data

# Behind Caddy. Without this the app sees every request as coming from
# 127.0.0.1, so the rate limiters throttle everyone together and the audit log
# records the proxy's address instead of the client's.
# TRUST_PROXY=1

# The firm's own day: reminders go out at 08:00 here and "overdue" is measured
# against this calendar.
# FIRM_TIMEZONE=America/Chicago

# The public origin, for the invitation and reset links that go into emails.
# CORS_ORIGIN=https://docs.yourfirm.com
# PUBLIC_URL=https://docs.yourfirm.com

# Scanning is REQUIRED in production regardless of this line — the code ignores
# SCAN_REQUIRED=false when NODE_ENV=production. Set the endpoint if clamd is
# not on the default loopback port.
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310
