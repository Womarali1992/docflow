# Copy to .env and adjust for your environment.
DATABASE_URL=postgres://docflow:docflow_dev@localhost:5432/docflow

# REQUIRED in production — the server refuses to start without a real secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev_only_secret_change_me_in_production

PORT=4000
CORS_ORIGIN=http://localhost:8080
NODE_ENV=development
