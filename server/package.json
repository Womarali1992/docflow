{
  "name": "docflow-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "node scripts/clean.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "worker": "tsx src/worker.ts",
    "worker:start": "node dist/worker.js",
    "test": "vitest run",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "status": "node scripts/status.mjs",
    "mail:check": "node scripts/mail-check.mjs",
    "count": "node scripts/count.mjs",
    "integrity": "node scripts/integrity.mjs",
    "legacy:redundancy": "node scripts/legacy-redundancy.mjs",
    "files:orphans": "node scripts/orphans.mjs",
    "backup:manifest": "node scripts/manifest.mjs",
    "backup:record": "node scripts/record-backup.mjs",
    "db:create": "node scripts/create-db.mjs",
    "totp": "node scripts/totp.mjs",
    "admin": "tsx src/admin.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:demo": "tsx src/db/demo.ts",
    "db:studio": "drizzle-kit studio"
  },
  "_overridesWhy": "qs 6.16.0 closes two qs advisories that express 4.22.2 — the last express 4 — still pins ~6.15.1 against. Upstream's fix is express 5; lifting the transitive one minor is the smaller change. Drop this when express 5 lands.",
  "overrides": {
    "qs": "^6.16.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.0",
    "file-type": "^22.0.2",
    "helmet": "^8.3.0",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.1",
    "otplib": "^12.0.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.5.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.30.0",
    "supertest": "^7.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3",
    "vitest": "^3.2.4"
  }
}
