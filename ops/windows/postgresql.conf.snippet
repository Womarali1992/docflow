# PostgreSQL 17 settings for the DocFlow pilot machine (C5.3).
#
# Append to (or reconcile with) the settings in
#   <PGDATA>\postgresql.conf
# then:  Restart-Service postgresql-x64-17
#
# <PGDATA> should be on the encrypted data volume, not on C:. Postgres holds
# the same client information the documents do; encrypting the documents and
# leaving the database on an unencrypted disk protects nothing.

# --- Reachability ------------------------------------------------------------
# The only things that talk to this database are the API and the worker, both on
# this machine. Nothing else should be able to open a socket to it — the firewall
# blocks 5432 as well, but this is the setting that actually matters.
listen_addresses = 'localhost'
port = 5432

# --- Authentication ----------------------------------------------------------
# scram-sha-256 for every connection. See pg_hba.conf.example: no `trust`, ever,
# not even for localhost.
password_encryption = scram-sha-256

# --- Sizing for one firm -----------------------------------------------------
# A single CPA with ten clients is a small database. These are chosen so the
# machine stays responsive while someone is also using it as a desktop, not to
# win a benchmark.
max_connections = 50
shared_buffers = 512MB
effective_cache_size = 1536MB
work_mem = 8MB
maintenance_work_mem = 128MB

# --- Durability --------------------------------------------------------------
# The pilot's data is a firm's tax records; a transaction that is acknowledged
# must survive the power going out. Do not "tune" these.
fsync = on
synchronous_commit = on
full_page_writes = on

# WAL kept for a day, so a backup taken during a busy afternoon is consistent
# and a point-in-time restore stays possible if the firm ever wants one.
wal_level = replica
max_wal_size = 2GB
min_wal_size = 256MB
checkpoint_timeout = 15min

# --- Logging -----------------------------------------------------------------
# Enough to answer "what happened on Tuesday", not so much that the log becomes
# the thing that fills the disk.
logging_collector = on
log_directory = 'log'
log_filename = 'postgresql-%Y-%m-%d.log'
log_rotation_age = 1d
log_rotation_size = 50MB
log_truncate_on_rotation = on
log_min_duration_statement = 2000   # anything slower than 2s is worth seeing
log_connections = off               # the app's audit log covers who signed in
log_disconnections = off
log_line_prefix = '%m [%p] %q%u@%d '
log_timezone = 'UTC'                # the app converts; logs stay comparable

# --- Autovacuum --------------------------------------------------------------
# On, and left alone. The tables that churn (sessions, jobs, notifications) are
# exactly the ones that need it.
autovacuum = on
